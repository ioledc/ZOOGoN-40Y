FROM rocker/tidyverse:4
# cache bust: render-report added
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq \
    libjq1 \
    libjq-dev \
    curl \
  && rm -rf /var/lib/apt/lists/*

# Install Quarto
RUN curl -LO https://quarto.org/download/latest/quarto-linux-amd64.deb && \
    dpkg -i quarto-linux-amd64.deb && \
    rm quarto-linux-amd64.deb

# Install Chromium for Mermaid rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
  && rm -rf /var/lib/apt/lists/*
ENV CHROMIUM_PATH=/usr/bin/chromium

# Install TinyTeX for PDF rendering
RUN Rscript -e 'install.packages("tinytex"); tinytex::install_tinytex()'
ENV PATH="/root/.TinyTeX/bin/x86_64-linux:${PATH}"

RUN install2.r --error --skipinstalled \
    readr \
    stringr \
    tibble \
    janitor \
    magrittr \
    rlang \
    dotenv \
    httr2 \
    arrow \
    git2r \
    config \
    logger \
    purrr \
    EML \
    xml2 \
    openxlsx \
    remotes

RUN install2.r --error --skipinstalled \
    testthat \
    knitr \
    rmarkdown \
    quarto \
    pacman \
    pkgdown \
    worrms \
    lubridate \
    ggsci \
    viridis \
    cowplot \
    vegan \
    gridExtra

RUN Rscript -e 'remotes::install_github("LivingNorway/LivingNorwayR")'

COPY . /home
WORKDIR /home
RUN Rscript -e 'remotes::install_local(dependencies = TRUE, upgrade = "never")'
RUN Rscript -e 'library(ZooGoN); cat("ZooGoN loaded successfully\n")'
ENTRYPOINT ["Rscript"]