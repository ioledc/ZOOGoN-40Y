# Pin to specific R version — locks R itself AND the Posit Package Manager (RSPM)
# snapshot date, so all install2.r packages come from a frozen CRAN snapshot.
# To upgrade: change the version tag, rebuild, and test.
FROM rocker/tidyverse:4.5.1
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq \
    libjq1 \
    libjq-dev \
    curl \
    libglpk40 \
  && rm -rf /var/lib/apt/lists/*

# Install Quarto — pinned version (update alongside R when upgrading the base image)
RUN curl -LO https://github.com/quarto-dev/quarto-cli/releases/download/v1.9.36/quarto-1.9.36-linux-amd64.deb && \
    dpkg -i quarto-1.9.36-linux-amd64.deb && \
    rm quarto-1.9.36-linux-amd64.deb

# Install TinyTeX for PDF rendering
RUN Rscript -e 'install.packages("tinytex"); tinytex::install_tinytex()'
ENV PATH="/root/.TinyTeX/bin/x86_64-linux:${PATH}"

RUN install2.r --error --skipinstalled \
    readr \
    stringr \
    tibble \
    janitor \
    magrittr \
    rlang \
    dotenv \
    httr2 \
    arrow \
    git2r \
    config \
    logger \
    purrr \
    EML \
    xml2 \
    openxlsx \
    remotes

RUN install2.r --error --skipinstalled \
    testthat \
    knitr \
    rmarkdown \
    quarto \
    pacman \
    pkgdown \
    worrms \
    lubridate \
    ggsci \
    viridis \
    cowplot \
    vegan \
    gridExtra \
    DiagrammeR

# Report dependencies — pure R/JS wrappers (fast, no compilation)
RUN install2.r --error --skipinstalled \
    highcharter \
    htmlwidgets \
    DT \
    RColorBrewer \
    reactable

# Report dependencies — time-series packages (Fortran/C++ compilation; best-effort)
RUN install2.r --skipinstalled \
    tsibble \
    tsfeatures

# Pin to stable release tag so upstream changes do not break the pipeline
RUN Rscript -e 'remotes::install_github("LivingNorway/LivingNorwayR@v1.0.0")'

COPY . /home
WORKDIR /home
RUN Rscript -e 'remotes::install_local(dependencies = TRUE, upgrade = "never")'
RUN Rscript -e 'library(ZooGoN); cat("ZooGoN loaded successfully\n")'
ENTRYPOINT ["Rscript"]